# ai-detect configuration — copy to `.env` and adjust.
# Bun loads `.env` automatically on startup. Every value also has a
# Dockerfile default (used when no `.env` / -e flag is given).

# HTTP port the web UI + API + MCP serve on
PORT=3000

# Chunk worker pool: chunks (across ALL files) run in parallel up to this.
# Default 5, hard cap 10. Raise for speed, lower if upstream throttles you.
CHUNK_CONCURRENCY=5

# Parallel reCAPTCHA token contexts in the single shared Chromium.
# Defaults to CHUNK_CONCURRENCY so minting never bottlenecks the pool.
# TOKEN_CONCURRENCY=5

# Min gap (ms) between chunk submits, shared across workers (politeness).
SUBMIT_GAP_MS=1500

# Optional paid fallback when the local browser can't mint a token.
# CAPSOLVER_KEY=

# Path to a Chrome/Chromium binary (image default: /usr/bin/chromium).
# CHROME_EXECUTABLE=/usr/bin/chromium
