    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "typescript": "^5.7.0"
  }
}
